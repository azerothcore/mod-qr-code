[worldserver]

###################################################################################################
#    QR code module config
###################################################################################################
#
#    Every pixel value below is a client-side measurement. They are config options rather than
#    constants so they can be retuned with ".reload config" - no restart and no rebuild - using the
#    ".qr grid" and ".qr probe" diagnostics.
#
#    QRCode.Enable
#        Description: Enables/disables the .qr command family.
#        Default:     1
#
#    QRCode.Backend
#        Description: Where the generated code is drawn by the bare ".qr" command. The gossip menu
#                     is not a backend: it is the ".qr gossip" command, which always prints via
#                     chat after its "Show the QR code" option is picked.
#                     1 - system chat, one message per module row. Resizable frame, no width cap.
#                     2 - a quest details frame. WARNING: a full-size code in the quest description
#                         has crashed the 3.3.5 client outright; treat this backend as experimental
#                         and calibrate upward from small ".qr grid" sizes before trusting it.
#        Default:     1
#
#    QRCode.ErrorCorrection
#        Description: QR error correction level: L, M, Q or H.
#                     L is the theoretical fit - the display is pixel-perfect, so the failure mode
#                     is geometric rather than noisy - but raising it is the second lever to pull if
#                     residual row seams stop codes from scanning.
#        Default:     "L"
#
#    QRCode.MaxVersion
#        Description: Largest QR version the encoder may pick (1-40). It is a ceiling, not a size:
#                     every payload still renders at the smallest version that holds it, so raising
#                     this changes nothing until something needs the room.
#
#                     The default covers ".account 2fa qrcode", whose link runs to 69-90 bytes and
#                     so needs version 4 or 5. Geometry caps this well below 40 - the quest frame
#                     cannot show past version 3, and chat past version 5 is unwieldy.
#        Default:     5
#
#    QRCode.MaxInputLength
#        Description: Longest accepted input, in bytes, checked before encoding purely to bound the
#                     work done. The encoder remains the authority on real capacity and rejects
#                     shorter input that still does not fit.
#        Default:     96
#
#    QRCode.MaxPayloadBytes
#        Description: Hard cap on the generated escape-sequence string, in bytes. A version 1 code
#                     runs to roughly 15 KB, a version 3 one to 27 KB and a version 4 one to 37 KB,
#                     at about 1 KB per chat line, so a low value here rejects everything. Measure
#                     the client's real inbound limit with ".qr probe" first and set this below it.
#        Default:     48000
#
#    QRCode.CooldownSeconds
#        Description: Per-player cooldown on the .qr commands. Each invocation ships tens of
#                     kilobytes, so this is what stops the command being a bandwidth amplifier.
#                     Set to 0 while tuning geometry, then put it back.
#        Default:     5
#
#    QRCode.QuietZone
#        Description: Light border drawn on every side of the code, in modules, 1 to 4. The QR spec
#                     asks for 4 and decoders are calibrated against it.
#
#                     The default is below the spec on purpose. The border is charged in chat lines
#                     like everything else - each module of it is two more rows the frame has to show
#                     at once - and running out of frame height is the failure this module actually
#                     hits: a version 4 code needs 35 lines at 1 and 41 at 4. Raise it if a code will
#                     not scan.
#        Default:     1
#
#    QRCode.TwoFA.Enable
#        Description: Offers the ".account 2fa qrcode" command. When 0 the command refuses and
#                     points the player at ".account 2fa setup".
#
#                     A two-factor payload needs a version 4 symbol: 35 module rows at QuietZone 1,
#                     which is 18 chat lines with PackRows on and 35 without. 18 fits a default
#                     chat frame, which is what makes the command usable at all - a player who can
#                     see two thirds of a code is worse off than one never offered it.
#
#                     Turn this off if you also turn PackRows off, or check ".qr grid 35" fits
#                     first. A smaller chat font (right-click the chat tab, Font Size) buys the
#                     room, and LineAdvance has to be retuned after changing it.
#        Default:     1
#
#    QRCode.TwoFA.Issuer
#        Description: Name the authenticator app shows above the generated tokens for
#                     ".account 2fa qrcode". Empty means the realm name.
#
#                     It is worth overriding when the realm name is long: the issuer sits in a
#                     payload with only a few bytes of slack, and going one byte over pushes the
#                     code up a QR version, which is four more rows of chat to fit on screen.
#        Default:     ""
#
#    QRCode.AnchorBottom
#        Description: Which end of the grid keeps its natural position.
#
#                     A row's offset moves only what is drawn, never the height its text line
#                     reserves, so modules shorter than a line always leave slack somewhere -
#                     and the smaller the modules, the more of it.
#
#                     1 puts the last row on its own line, so the code sits just above the chat
#                     input box and the slack lands above it, reading as ordinary empty chat.
#                     0 puts the first row on its own line, leaving the code floating high in the
#                     frame with a conspicuous gap underneath.
#        Default:     1
#
###################################################################################################
#
#    MODULE TEXTURES
#
#    The 3.3.5a client accepts the vertex-colour arguments of the |T escape and then discards
#    them, so a module cannot be tinted - its colour has to come from a texture that already is
#    that colour. Which client textures are usable is not something the server can know, so both
#    are settings.
#
#    Paths take forward or back slashes and no file extension. Preview any candidate in-game
#    without restarting anything - the client doubles a typed | to ||, so the pipe has to be
#    built with string.char(124) or the escape prints as literal text:
#
#        /run P=string.char(124) DEFAULT_CHAT_FRAME:AddMessage(P.."TInterface/Buttons/WHITE8X8:24:24"..P.."t")
#
#    QRCode.DarkTexture
#        Description: Texture drawn for dark modules. The default is a dark stone panel background.
#        Default:     "Interface/DialogFrame/UI-DialogBox-Background"
#
#    QRCode.DarkTexCoords
#        Description: Sub-rect of the dark texture, as "texWidth:texHeight:left:right:top:bottom".
#                     The client divides the edges by the stated dimensions, so the default reads
#                     as "the middle 10%" whatever the texture's real size is.
#                     Cropping matters for a patterned texture: stretching the whole thing across
#                     a module shows the pattern, while a small flat crop gives an even block, and
#                     evenness is what a decoder needs. Leave empty to draw the whole texture.
#        Default:     "100:100:45:55:45:55"
#
#    QRCode.LightTexture
#        Description: Texture drawn for light modules, including the quiet zone.
#                     "Interface/ChatFrame/ChatFrameBackground" is an equally good white.
#        Default:     "Interface/Buttons/WHITE8X8"
#
#    QRCode.LightTexCoords
#        Description: Sub-rect of the light texture, same format as QRCode.DarkTexCoords.
#                     Empty by default - WHITE8X8 is a flat colour, so there is nothing to crop.
#        Default:     ""
#
###################################################################################################
#
#    COLOUR PALETTES
#
#    ".qr color <name> <text>" draws a code with its dark modules in a named colour. Only the dark
#    side changes: light is what a decoder thresholds against, so colouring it spends the contrast
#    the code is carrying.
#
#    black, red, blue, green, yellow and purple are compiled in and need no configuration at all -
#    the blocks at the end of this section restate the built-in values so they are visible and easy
#    to edit, and deleting them changes nothing. Every field is overridable on its own: set only
#    DarkTexCoords and the built-in texture is still used.
#
#    red, blue and green are confirmed scanning in-game. yellow and purple reuse the same gem
#    family, variant and crop, so they are a short reach rather than a new guess, but they have not
#    been checked - and yellow is the likeliest of the set to come out too light to threshold.
#
#    "black" is the control. It reuses a crop the original texture search measured as flat, opaque
#    and luminance 0, so it draws the same colour an ordinary code does and is useless as a colour.
#    It is here to separate two failures: if ".qr color black" scans and ".qr color red" does not,
#    the palette machinery is fine and the red texture is the problem. Start there.
#
#    Extra colours are added the same way, under any name. Palette names are read from the option
#    keys themselves, so a new colour is one option and a ".reload config" - there is no list to
#    keep in step and nothing to rebuild. ".qr color" with no name lists what the realm has.
#
#    Two things decide whether a colour works, and neither is how it looks:
#
#    1. LUMINANCE. A decoder thresholds brightness, not hue. Pure red comes out around 54 of 255
#       and pure blue around 18, so both read as dark against white and scan. Pure green is about
#       182 - barely darker than the white background - and will not. A green that scans has to be
#       dark enough that it reads nearly black anyway. Yellow (around 226) is hopeless.
#    2. FLATNESS AND OPACITY. A crop is stretched across a whole merged run of modules, so a
#       gradient smears. Any alpha in the crop shows the chat frame's dark background through it,
#       which destroys the light side of the code.
#
#    A coloured palette almost always costs three times the lines. Packing needs a texture holding
#    the colour and the white as stacked bands in one crop, and the black-and-white search that
#    produced the QRCode.Pack.* defaults found two usable textures in the whole client - a coloured
#    equivalent is unlikely to exist. Without a complete QRCode.Palette.<name>.Pack.* set the colour
#    falls back to one module row per line, so keep coloured codes short. A version 1 payload is 23
#    lines, which a default chat frame shows; a 2FA payload at 35 is not worth attempting in colour.
#
#    The coloured built-ins crop gem icons. Interface/Icons is the one directory this module has
#    already proven resolves - the pack defaults reach into it - and a gem icon is a large,
#    saturated, single-hue object filling most of its 64x64 frame, which is about the closest the
#    client comes to shipping a flat colour swatch. The crop takes the middle quarter, where the
#    stone is rather than its border or highlight.
#
#    THE COLOURED PATHS ARE CANDIDATES, NOT MEASUREMENTS, and one earlier set was already wrong:
#    Interface/COMMON/Indicator-* does not exist, so it drew nothing at all and the chat frame's
#    dark background read as black modules. Which textures carry a flat opaque region of a given
#    hue cannot be known from the server side, so check before putting one in front of players.
#
#    Two commands do that. Start with a sweep, which divides a texture into a grid of crops and
#    draws one bar per cell with the coordinates beside it:
#
#        .qr sweep Interface/Icons/INV_Misc_Gem_Ruby_02
#
#    Every bar blank means the path is wrong, not the crop. Otherwise pick the bar that looks flat
#    and dark and confirm its coordinates:
#
#        .qr swatch Interface/Icons/INV_Misc_Gem_Ruby_02 100:100:25:50:25:50
#
#    That draws the crop three ways - solid, against white, against the configured dark - and
#    prints the config lines to paste. Band 2 must read as a clean checker or the colour is too
#    light to scan; band 3 must not look solid or the colour is indistinguishable from black.
#
#    QRCode.Palette.<name>.DarkTexture
#        Description: Texture drawn for dark modules in this colour. A name with no dark texture
#                     and no built-in is not offered, and the module logs which one it dropped.
#
#    QRCode.Palette.<name>.DarkTexCoords
#        Description: Sub-rect of that texture, same "texWidth:texHeight:left:right:top:bottom"
#                     format as QRCode.DarkTexCoords. Stating 100:100 makes the edges percentages,
#                     which is the right form for a candidate whose real pixel size is unknown.
#
#    QRCode.Palette.<name>.LightTexture / QRCode.Palette.<name>.LightTexCoords
#        Description: Optional, and only wanted for a colour too light to be a module. Setting it
#                     draws black modules on a coloured ground instead of coloured modules on
#                     white, which is the only way a bright colour scans - gold measures around
#                     190 of 255 and no crop of it separates from a white background. Leave both
#                     unset and the code keeps QRCode.LightTexture, as the dark-side colours do.
#
#    QRCode.Palette.<name>.Pack.<PATTERN>.Texture / .TexCoords
#        Description: Optional packed styles for this colour, same patterns as QRCode.Pack.*. The
#                     set is all or nothing: a partial one is ignored whole, with a log line saying
#                     so, because a grid with holes still looks like a code and still will not scan.
#
###################################################################################################

QRCode.Palette.black.DarkTexture = "Interface/Glues/Login/Glues-GermanRating"
QRCode.Palette.black.DarkTexCoords = "128:128:1:51:89:100"

QRCode.Palette.red.DarkTexture = "Interface/Icons/INV_Misc_Gem_Ruby_02"
QRCode.Palette.red.DarkTexCoords = "64:64:30:34:38:42"

QRCode.Palette.blue.DarkTexture = "Interface/Icons/INV_Misc_Gem_Sapphire_02"
QRCode.Palette.blue.DarkTexCoords = "64:64:30:34:38:42"

QRCode.Palette.green.DarkTexture = "Interface/Icons/INV_Misc_Gem_Emerald_02"
QRCode.Palette.green.DarkTexCoords = "64:64:30:34:38:42"

QRCode.Palette.purple.DarkTexture = "Interface/Icons/INV_Misc_Gem_Amethyst_02"
QRCode.Palette.purple.DarkTexCoords = "1000:1000:809:815:809:815"

# Gold is too light to be a module, so yellow colours the ground and keeps black modules.
QRCode.Palette.yellow.DarkTexture = "Interface/Glues/Login/Glues-GermanRating"
QRCode.Palette.yellow.DarkTexCoords = "128:128:1:51:89:100"
QRCode.Palette.yellow.LightTexture = "Interface/Icons/INV_Misc_Gem_Topaz_02"
QRCode.Palette.yellow.LightTexCoords = "64:64:30:34:38:42"

###################################################################################################
#
#    ROW PACKING
#
#    A code is one chat line per module row by default, and running out of frame height is the
#    failure this module actually hits. Packing draws several module rows inside one escape, cutting
#    the line count by that factor: a version 4 code needs 35 lines at 1 row, 18 at 2, 12 at 3.
#
#    It buys far less in bytes than it looks. A run has to agree on every row it spans, so merging
#    weakens as fast as the line count falls. Packing is for lines, not payload size.
#
#    The ceiling is the chat font's fixed line advance, around 16 px. While
#    RowsPerLine * ModuleHeight stays under it the line keeps its normal height and the saving is
#    real; past it the line grows to fit the taller escape and hands the saving straight back. Two
#    7 px modules come to 14 px and fit, which is why 2 is free at the shipped module size. Three
#    need ModuleHeight around 5 to stay inside, and LineAdvance retuned to match.
#
#    A packed escape needs a texture that already contains the whole column, since one escape names
#    only one texture. Of 14k client textures, 80 carry a hard black/white edge in both directions
#    and only 2 have flat bands, so the supply is the real limit: 2 rows is comfortable, 3 is
#    marginal, 4 has no usable set at all.
#
#    QRCode.RowsPerLine
#        Description: Module rows drawn per chat line, 1 to 4.
#                     1 draws one row per line from QRCode.DarkTexture / QRCode.LightTexture and
#                     ignores every QRCode.Pack.* option below.
#                     3 is the default, paired with the 5 px ModuleHeight and -4 LineAdvance
#                     below: three 5 px rows come to 15 px, which still fits the line advance.
#                     2 is the safer fallback, and wants ModuleHeight back around 7.
#                     Raising ModuleHeight without lowering RowsPerLine grows the line and
#                     hands the saving straight back.
#        Default:     3
#
#    QRCode.Pack.<PATTERN>.Texture / QRCode.Pack.<PATTERN>.TexCoords
#        Description: Style for one column pattern, where PATTERN spells the column's modules top
#                     to bottom as L and D, one letter per row. At RowsPerLine 2 that is LL, LD, DL
#                     and DD; at 3 it is LLL through DDD. Every pattern for the chosen RowsPerLine
#                     must resolve to a texture or the module logs the gap and falls back to one
#                     row per line, because a grid with holes still looks like a code and still
#                     will not scan.
#
#                     TexCoords are stated against the texture's real pixel size rather than as
#                     percentages: exact, and shorter, which matters because a crop is charged on
#                     every escape.
#
                     Band thickness matters as much as colour. The client scales the crop into
#                     an escape two modules tall, so 13 px bands scale down and keep a hard edge
#                     while 3 px bands scale up into a two-pixel ramp. Thresholding eats the soft
#                     edge, the module row comes out short, and a row's height ends up depending
#                     on which pattern drew it. Decoders cope with a uniform stretch but not with
#                     row-by-row jitter, so mixed patterns want bands well thicker than a module.
#
#                     A candidate has to be neutral, not just the right brightness: luminance
#                     alone lets a tan pixel through, and RGB 240,236,152 scores about 230 while
#                     rendering as a visibly yellow module. Most client artwork is warm, which
#                     rules it out.
#
#                     Defaults for 2 rows crop the USK age-rating badge, which gives luminance 0
#                     above 248 with flat bands, and is the set checked in-game. Defaults for 3
#                     rows are neutral but uneven: most darks sit near 32 while LDL is 1 and DLD
#                     is 26-37, and LDL and DLD come from bands only 2-3 px tall, which blur when
#                     stretched to a module.
#
#                     All patterns in use must agree on their black and their white. A mismatch
#                     makes the seam between lines read as a module edge.
#
###################################################################################################
#
#    CHAT BACKEND GEOMETRY
#
#    The chat frame is resizable by the player, so there is no width to fit inside, and modules can
#    stay square.
#
#    The catch is that the chat font sets the row spacing, at roughly 16 px, and it does not shrink
#    when the modules do. Below that height every row opens a gap, which LineAdvance exists to close.
#
#    QRCode.Chat.ModuleWidth
#        Description: Drawn width of one module, in pixels. A version 1 code is 29 modules across
#                     including the quiet zone, so 7 px lands at 203 px and 14 px at 406 px. Rows
#                     wider than the chat frame wrap, which destroys the grid.
#        Default:     7
#
#    QRCode.Chat.ModuleHeight
#        Description: Drawn height of one module, in pixels. Keep it equal to ModuleWidth for square
#                     modules.
#        Default:     7
#
#    QRCode.Chat.LineAdvance
#        Description: Controls the per-row vertical offset, which is (LineAdvance - ModuleHeight)
#                     applied cumulatively down the grid.
#
#                     Read it as a dial, not as a measurement: the client treats a positive offset
#                     as upward, so a LOWER value pulls the rows TIGHTER together, and negative
#                     values are normal. The default of 0 lifts each row by 7 px, which cancels the
#                     chat font's spacing and lands the rows flush - measured in-game, not derived.
#
#                     Tune with ".qr grid": gaps left between rows means go lower, rows overlapping
#                     or squashing together means go higher. Changing ModuleHeight moves the right
#                     value with it, so retune after any size change.
#        Default:     0
#
#    QRCode.Chat.MaxRowWidth
#        Description: Widest row to allow, in pixels; 0 for no limit. Chat has no width cap.
#        Default:     0
#
###################################################################################################
#
#    QUEST BACKEND GEOMETRY
#
#    The quest description pane is roughly 285 px wide and scrolls vertically, so modules have to be
#    narrow and non-square. That is fine for decoding - a uniform aspect scale is an affine
#    transform, which decoders resolve from the three finder patterns - but it does mean the row
#    offset is doing real work here.
#
#    QRCode.Quest.ModuleWidth
#        Description: Drawn width of one module, in pixels. At version 3 the code is 37 modules
#                     wide including the quiet zone, so 7 px lands at 259 px.
#        Default:     7
#
#    QRCode.Quest.ModuleHeight
#        Description: Drawn height of one module, in pixels. Below LineAdvance, which is what makes
#                     the row offset necessary.
#        Default:     9
#
#    QRCode.Quest.LineAdvance
#        Description: Same dial as QRCode.Chat.LineAdvance, lower being tighter. This default is
#                     extrapolated from the chat measurement, not measured in the quest pane, so
#                     expect to tune it with ".qr grid" after switching backends.
#        Default:     2
#
#    QRCode.Quest.MaxRowWidth
#        Description: Widest row to allow, in pixels; 0 for no limit. A row past the pane width
#                     wraps, which destroys the grid, so the command is refused instead.
#        Default:     285
#
###################################################################################################

QRCode.Enable = 1
QRCode.Backend = 1
QRCode.ErrorCorrection = "L"
QRCode.MaxVersion = 5
QRCode.MaxInputLength = 96
QRCode.MaxPayloadBytes = 48000
QRCode.CooldownSeconds = 5
QRCode.QuietZone = 1
QRCode.TwoFA.Enable = 1
QRCode.TwoFA.Issuer = ""
QRCode.AnchorBottom = 1

QRCode.DarkTexture = "Interface/DialogFrame/UI-DialogBox-Background"
QRCode.DarkTexCoords = "100:100:45:55:45:55"
QRCode.LightTexture = "Interface/Buttons/WHITE8X8"
QRCode.LightTexCoords = ""

QRCode.RowsPerLine = 3

QRCode.Pack.LL.Texture = "Interface/Buttons/WHITE8X8"
QRCode.Pack.LL.TexCoords = ""
QRCode.Pack.LD.Texture = "Interface/Glues/Login/Glues-KoreanRating-Fear"
QRCode.Pack.LD.TexCoords = "128:128:90:102:75:123"
QRCode.Pack.DL.Texture = "Interface/Glues/Login/Glues-GermanRating"
QRCode.Pack.DL.TexCoords = "128:128:2:52:88:114"
QRCode.Pack.DD.Texture = "Interface/Glues/Login/Glues-GermanRating"
QRCode.Pack.DD.TexCoords = "128:128:1:51:89:100"

QRCode.Chat.ModuleWidth = 4
QRCode.Chat.ModuleHeight = 5
QRCode.Chat.LineAdvance = -4
QRCode.Chat.MaxRowWidth = 0

QRCode.Quest.ModuleWidth = 7
QRCode.Quest.ModuleHeight = 9
QRCode.Quest.LineAdvance = 2
QRCode.Quest.MaxRowWidth = 285
